[project]
name = "{{ name }}"
version = "0.0.1"
description = "AgentPave service {{ name }}, scaffolded from the agent-tools template"
requires-python = ">=3.12"
dependencies = [
    # boto3 is provided by the Lambda runtime and must never be vendored:
    # a second copy is dead weight in the asset and a version that can drift
    # from the one AWS patches.
    "boto3>=1.35",
    "requests>=2.32",
    # Not an optional extra. It was one, and the effect was that nothing
    # vendored it, `_tracer()` returned None in the deployed Lambda, and no
    # span was ever emitted — while the deployed gate reported the service as
    # traced, because Lambda's own X-Ray segments exist regardless (ADR-024).
    "opentelemetry-api>=1.27",
    "opentelemetry-sdk>=1.27",
]

# pydantic and pyyaml were listed here and are not: the rendered service
# imports neither. They were template cruft, and cruft in this list is not
# harmless — every name here is a package the asset has to carry, and one
# nobody vendors is a 502 waiting for its first deploy.
#
# Every runtime dependency here except boto3 must also be vendored by the
# Makefile's SERVICE_DEPS. The Lambda runtime provides boto3 and botocore and
# nothing else; a package declared here and vendored nowhere kills the function
# at import, with a bare "Internal Server Error" and no line of our code run.
# `test_pave_asset.py` cross-checks the two lists so that fails in `make check`.

# There is deliberately no bedrock client here. This service reaches models
# only through the gateway (ARCHITECTURE.md invariant 1), and its IAM role
# holds zero `bedrock:*` — asserted in `cdk synth`, not trusted.

# The package is `{{ package }}`, never `{{ name }}`. A directory whose name
# matches a module shadows it as a namespace package the moment the repo root
# is on sys.path — which it is under pytest (ADR-004).
[tool.setuptools.packages.find]
include = ["{{ package }}*"]

# The scaffolded service lints by the platform's rules, not ruff's defaults.
# Without this it inherits an 88-column default while the platform uses 100,
# so a service that is clean in its own directory is dirty in the monorepo —
# and the render gate, which lints the output, disagrees with `make check`.
[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"
